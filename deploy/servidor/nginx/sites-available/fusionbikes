server {
    listen 80 default_server;
    server_name _;

    # E1 T3 C5 (2026-09-16): el plano de control interno del legado nunca se publica. Regex
    # insensible a mayúsculas porque Express enruta sin distinguirlas, y con el prefijo
    # /herramientas/ opcional porque ese location proxea con barra final y lo quita.
    location ~* ^/(herramientas/+)?internal(/|$) {
        return 404;
    }

    location /herramientas/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        client_max_body_size 20m;
    }

    # Las paginas de herramientas llaman a fetch('/api/...') con ruta absoluta
    # (no relativa a /herramientas/), asi que /api tambien se reenvia directo.
    location /api/ {
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        client_max_body_size 20m;
    }

    # Las fotos subidas se guardan con URL absoluta /uploads/... (igual que /api),
    # asi que tambien necesitan su propio location hacia el backend Node.
    location /uploads/ {
        proxy_pass http://127.0.0.1:3001/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        client_max_body_size 20m;
    }

    location = / {
        return 302 /herramientas/home/;
    }
}
