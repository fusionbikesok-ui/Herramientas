PORT=3001
GEMINI_KEY=
WOO_URL=https://fusionbikes.com.ar
WOO_CK=
WOO_CS=
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
DB_PATH=./data/fusion.sqlite
SESSION_SECRET=cambiar-por-uno-largo-y-aleatorio
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Fusion Bikes Herramientas <tucuenta@gmail.com>
APP_URL=http://179.197.74.83

# Estado de pedido WC "listo para enviar Andreani" (cola de preparación)
ANDREANI_ORDER_STATUS=lpaandreani

# Notificaciones push (Hito 7, backend para la app móvil — iOS/Android/web vía FCM).
# 'mock': solo para desarrollo/pruebas; en producción el arranque falla si no se usa 'fcm'.
PUSH_PROVIDER=mock
# Control fail-closed de entregas de push: solo 'true' explícito habilita el envío real a FCM.
# Cualquier otro valor (ausencia, 'false', etc.) pausa el worker — no depende de NODE_ENV.
PUSH_REAL_ENABLED=false
# Minutos entre reavisos de un incidente crítico que sigue activo (evita acosar con
# notificaciones repetidas por el mismo incidente sin resolver).
REAVISO_INCIDENTE_MIN=30
# Completar cuando PUSH_PROVIDER=fcm — credenciales de la cuenta de servicio de Firebase.
# Nunca commitear valores reales, solo referencia de qué variables hacen falta.
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# User ID del propietario de la tienda (quien recibe notificaciones de webhooks de ML).
# Su ausencia hace que TODO webhook de ML devuelva 503 Service Unavailable — ML puede deshabilitar
# la URL de notificaciones si el error se sostiene. Obligatorio en producción.
ML_USER_ID=

# E1 T3 (sombra, apagada por defecto). Sitio de la cuenta ML (p. ej. MLA): obligatorio para
# `missed_feeds` de items y a validar contra ML_USER_ID antes del canario.
# ML_SITE_ID=
# Gateway interno de sólo lectura para la plataforma: sin estas dos la ruta no existe.
# GATEWAY_KEYRING_FILE=/ruta/fuera/del/repo/gateway-keyring.json   (modo 600)
# GATEWAY_ORIGENES=172.16.0.0/24                                   (red de Docker; nunca 0.0.0.0/0)
# Llamadas por minuto de la sombra a ML. 0 = 429 sintético sin salir a red, hasta medir 7 días.
# GATEWAY_ML_SHADOW_RPM=0
# Copia de sombra posterior al ACK (lib/sombra.js). Sólo 'true' la enciende.
# SOMBRA_COPIA_ENABLED=false

# JWT de acceso de la app móvil (mínimo 32 caracteres, obligatorio al construir la app).
MOBILE_JWT_SECRET=cambiar-por-uno-largo-y-aleatorio-de-32-caracteres-o-mas

# Ingesta firmada del plugin WordPress Fusion Bikes - Live Chat (POST /v1/events).
FUSION_CHAT_EVENTS_API_KEY=
FUSION_CHAT_EVENTS_SECRET=

# Contrato de financiación de Master Control (WordPress): coeficientes y precio financiado
# por plan de cuotas, que Gestión de pedidos necesita para mostrar la diferencia de una
# edición según el plan del pedido. Mismo valor que la constante FUSION_API_TOKEN definida
# en el wp-config.php de la tienda. Sin esto, la revisión de cambios informa que no puede
# calcular la financiación en vez de mostrar la diferencia de contado como si lo fuera.
MASTER_CONTROL_TOKEN=

# Ventana (en horas) de la importación incremental de Gestión de pedidos, que corre cada
# 10 minutos. La reconciliación completa del mes es el botón manual de la pantalla.
GESTION_PEDIDOS_VENTANA_HORAS=48
