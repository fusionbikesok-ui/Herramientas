# Estado de pedido WC "listo para enviar Andreani" (cola de preparación)
ANDREANI_ORDER_STATUS=lpaandreani

# Notificaciones push (Hito 7, backend para la app móvil — iOS/Android/web vía FCM).
# 'mock': solo para desarrollo/pruebas; en producción el arranque falla si no se usa 'fcm'.
PUSH_PROVIDER=mock
# Minutos entre reavisos de un incidente crítico que sigue activo (evita acosar con
# notificaciones repetidas por el mismo incidente sin resolver).
REAVISO_INCIDENTE_MIN=30
# Completar cuando PUSH_PROVIDER=fcm — credenciales de la cuenta de servicio de Firebase.
# Nunca commitear valores reales, solo referencia de qué variables hacen falta.
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# JWT de acceso de la app móvil (mínimo 32 caracteres, obligatorio al construir la app).
MOBILE_JWT_SECRET=cambiar-por-uno-largo-y-aleatorio-de-32-caracteres-o-mas
