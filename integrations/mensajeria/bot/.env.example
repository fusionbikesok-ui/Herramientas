APP_ENV=production
LOG_LEVEL=INFO
CHATBOT_BIND_PORT=8091

# Deben coincidir con WooCommerce > Chatbot y WhatsApp.
FUSION_API_KEY=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA
FUSION_CALLBACK_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO
WORDPRESS_BASE_URL=https://fusionbikes.com.ar

POSTGRES_DB=fusion_chatbot
POSTGRES_USER=fusion_chatbot
POSTGRES_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA
DATABASE_URL=postgresql://fusion_chatbot:REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA@postgres:5432/fusion_chatbot
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE=fusion:chatbot:events

# Meta / WhatsApp Cloud API. No escribir estos datos dentro del plugin WordPress.
META_GRAPH_VERSION=v26.0
META_APP_SECRET=PEGAR_APP_SECRET_DE_META
META_VERIFY_TOKEN=REEMPLAZAR_CON_UN_TOKEN_ALEATORIO
WHATSAPP_ACCESS_TOKEN=PEGAR_TOKEN_PERMANENTE_DE_META

# Reemplazar PHONE_NUMBER_ID_* por los identificadores que muestra Meta.
# Los números se expresan en formato internacional argentino.
WHATSAPP_NUMBERS_JSON={"PHONE_NUMBER_ID_VENTAS":{"label":"Ventas","display_number":"5493515214819"},"PHONE_NUMBER_ID_POSVENTA":{"label":"Posventa/Taller","display_number":"5493518752035"}}

# Endpoint OpenAI-compatible de la IA instalada en el VPS.
AI_ENABLED=true
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=ollama
AI_MODEL=REEMPLAZAR_CON_EL_MODELO_LOCAL
AI_TIMEOUT_SECONDS=90
AI_TEMPERATURE=0.2

# Si la IA no responde, el sistema deriva a una persona con un mensaje seguro.
FALLBACK_REPLY=En este momento necesito derivarte con un asesor de Fusion Bikes para responderte correctamente.

