{
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push --set-upstream origin *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin master*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(git push origin +*)",
      "Bash(git push --delete*)",
      "Bash(git push origin --delete*)"
    ]
  }
}
